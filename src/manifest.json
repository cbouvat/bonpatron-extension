{
    "name": "BonPatron - Correcteur orthographique",
    "version": "0.5",
    "author": "Camille Bouvat",
    "description": "Utilisez BonPatron d'un simple clic-droit !",
    "permissions": [
        "contextMenus",
        "activeTab",
        "storage",
        "<all_urls>"
    ],
    "icons": {
        "16": "/icons/16.png",
        "32": "/icons/32.png",
        "48": "/icons/48.png",
        "64": "/icons/64.png",
        "96": "/icons/96.png",
        "128": "/icons/128.png",
        "256": "/icons/256.png"
    },
    "background": {
        "service_worker": "background.min.js"
    },
    "action": {
        "default_icon": {
            "16": "/icons/16.png",
            "32": "/icons/32.png",
            "48": "/icons/48.png",
            "64": "/icons/64.png",
            "96": "/icons/96.png",
            "128": "/icons/128.png",
            "256": "/icons/256.png"
        },
        "default_title": "BonPatron",
        "default_popup": "popup.html"
    },
    "manifest_version": 3
}
